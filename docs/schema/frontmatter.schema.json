{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prompt-rules.org/schema/frontmatter.schema.json",
  "title": "Prompt Rules Standard Frontmatter",
  "description": "JSON Schema for validating Prompt Rules Standard YAML frontmatter.",
  "type": "object",
  "required": [
    "id",
    "title",
    "description",
    "version",
    "type",
    "license"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "type": {
      "type": "string",
      "enum": [
        "documentation",
        "rule",
        "schema",
        "index",
        "roadmap"
      ]
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "context": {
      "type": "object",
      "properties": {
        "include": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "patternProperties": {
    "^x-": true
  },
  "additionalProperties": false
}
